doVersionChange() {
    NEW_VERSION="$1"
    NEW_BASE="${NEW_VERSION%%[-+]*}"
    OLD_VERSION=$(sed -n 's|^    <version>\(.*\)</version>.*|\1|p' pom.xml | head -1)
    OLD_RE=$(printf '%s' "${OLD_VERSION}" | sed 's/[.]/\\./g')
    OLD_BASE_RE=$(printf '%s' "${OLD_VERSION%%[-+]*}" | sed 's/[.]/\\./g')
    APP_DIR=springboot-start-project/springboot-start-app

    "${MVN:-mvn}" -q versions:set -DnewVersion="${NEW_VERSION}" -DprocessAllModules=true -DgenerateBackupPoms=false

    for POM in $(find . -name pom.xml -not -path './.git/*' -not -path '*/target/*' -not -path './submodules/*' \
        -not -path './attic/*' -not -path './incubation/*' -not -path '*/archived/*'); do
        projectEditFile "${POM}" awk -v old="<version>${OLD_VERSION}</version>" -v new="<version>${NEW_VERSION}</version>" '
            /<groupId>/ { group = $0; sub(/.*<groupId>/, "", group); sub(/<\/groupId>.*/, "", group) }
            group == "info.setmy" && index($0, old) { sub(old, new) }
            { print }'
    done

    projectEditFile tomcat-start-project/Makefile sed -e "s/DOCKER_PROJECT_VERSION=\"${OLD_RE}\"/DOCKER_PROJECT_VERSION=\"${NEW_VERSION}\"/"
    projectEditFile tomcat-start-project/Dockerfile sed \
        -e "s/org\.label-schema\.version=\"${OLD_RE}\"/org.label-schema.version=\"${NEW_VERSION}\"/" \
        -e "s/tomcat-start-project-${OLD_RE}\.war/tomcat-start-project-${NEW_VERSION}.war/g"
    projectEditFile tomcat-start-project/Jailfile sed -e "s/tomcat-start-project-${OLD_RE}\.war/tomcat-start-project-${NEW_VERSION}.war/g"
    projectEditFile java-clojure/project.clj sed -e "s|info\.setmy/java-clojure \"${OLD_RE}\"|info.setmy/java-clojure \"${NEW_VERSION}\"|"
    projectEditFile java-clojure/deps.edn sed -e "s|info\.setmy/java-clojure \"${OLD_RE}\"|info.setmy/java-clojure \"${NEW_VERSION}\"|"

    for SPEC in "${APP_DIR}"/rpm/*.spec; do
        projectEditFile "${SPEC}" sed -e "s/%{!?smi_version:[0-9][0-9.]*}/%{!?smi_version:${NEW_BASE}}/"
    done

    projectEditFile "${APP_DIR}/src/site/markdown/rpm.md" sed \
        -e "s/\`${OLD_RE}\` gives version \`${OLD_BASE_RE}\`/\`${NEW_VERSION}\` gives version \`${NEW_BASE}\`/"
}
