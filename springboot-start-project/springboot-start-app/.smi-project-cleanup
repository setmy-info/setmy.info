SB=springboot-start-project
TEMPLATE_APP=springboot-start-app
NAME="$(projectName)"

removeRootModules() {
    projectRemoveMavenModulesExcept . business-commons business-logic "${SB}"
}

removeSpringBootModules() {
    projectRemoveMavenModulesExcept "${SB}" "${TEMPLATE_APP}" spring-boot-business-logic-starter
}

removeMavenPublishing() {
    for pom in pom.xml "${SB}/${TEMPLATE_APP}/pom.xml"; do
        projectRemoveXmlElement "${pom}" distributionManagement
        projectRemoveXmlElement "${pom}" plugin nexus-staging-maven-plugin
    done
}

renameArtifacts() {
    for artifact in multi-projects business-commons business-logic "${SB}" spring-boot-business-logic-starter "${TEMPLATE_APP}"; do
        projectRenameMavenArtifact "${artifact}" "${NAME}-${artifact}" pom.xml */pom.xml "${SB}"/*/pom.xml
    done
}

removeCleanupIncludes() {
    projectRemove .smi-project-cleanup "${SB}/${TEMPLATE_APP}/.smi-project-cleanup"
}

doCleanup() {
    projectStep removeRootModules
    projectStep removeSpringBootModules
    projectStep removeMavenPublishing
}

doRename() {
    projectStep renameArtifacts
}

doPost() {
    projectStep removeCleanupIncludes
}
