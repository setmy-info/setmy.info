# /opt/setmy.info/etc/springboot-start-app.env - EnvironmentFile of springboot-start-app.service
# Same variables as in Docker and Kubernetes, see keycloak.md.
JAVA_OPTS=-Djava.security.egd=file:/dev/urandom
SPRING_PROFILES_ACTIVE=dev

# Keycloak base URL without /realms/...
SMI_IAM_URL=https://example.com/iam
SMI_IAM_REALM=example
SMI_IAM_API_CLIENT_ID=springboot-start-app-api
SMI_IAM_SPA_CLIENT_ID=springboot-start-app-spa
# Optional
#SMI_IAM_ISSUER_URL=https://example.com/iam/realms/example
#SMI_IAM_JWK_SET_URL=http://keycloak.internal:8080/iam/realms/example/protocol/openid-connect/certs
#SMI_IAM_AUDIENCE=springboot-start-app-api
#SMI_IAM_PRINCIPAL_CLAIM=preferred_username
