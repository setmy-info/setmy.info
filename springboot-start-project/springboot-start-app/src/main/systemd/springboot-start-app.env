# /opt/setmy.info/etc/springboot-start-app/springboot-start-app.env - EnvironmentFile of springboot-start-app.service
# Example only: this file is NOT in the RPM. It belongs to the separate configuration repository/package
# of the machine. Same variables as in Docker and Kubernetes, see src/site/markdown/keycloak.md.
# The Spring profile is set by the installed RPM (live or test), not here.

# JVM flags, read by the java launcher itself
JDK_JAVA_OPTIONS=-Djava.security.egd=file:/dev/urandom

# Keycloak base URL without /realms/...
SMI_IAM_URL=https://example.com/iam
SMI_IAM_REALM=example
SMI_IAM_API_CLIENT_ID=springboot-start-app-api
SMI_IAM_SPA_CLIENT_ID=springboot-start-app-spa
# Optional
#SMI_IAM_ISSUER_URL=https://example.com/iam/realms/example
#SMI_IAM_JWK_SET_URL=http://keycloak.internal:8080/iam/realms/example/protocol/openid-connect/certs
#SMI_IAM_AUDIENCE=springboot-start-app-api
#SMI_IAM_PRINCIPAL_CLAIM=preferred_username

# Look at the smi-postgresql-create-db-sql NAME ENVIRONMENT (setmy-info-scripts), here NAME springboot_start_app:
#SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/springboot_start_app_live
#SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
#SPRING_DATASOURCE_USERNAME=livespringboot_start_app
#SPRING_DATASOURCE_PASSWORD=
#SPRING_LIQUIBASE_USER=livespringboot_start_appliquibase
#SPRING_LIQUIBASE_PASSWORD=
# TEST: the same with test, springboot_start_app_test, testspringboot_start_app, testspringboot_start_appliquibase
