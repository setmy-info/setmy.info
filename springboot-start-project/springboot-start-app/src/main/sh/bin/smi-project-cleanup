#!/bin/sh

set -eu

NAME="$(basename "${PWD}")"
SB=springboot-start-project
TEMPLATE_APP=springboot-start-app

step() {
    echo "${STAGE}: $1"
    "$@"
}

edit_file() {
    file="$1"
    shift
    [ -f "${file}" ] || return 0
    "$@" < "${file}" > "${file}.smi-tmp"
    cat "${file}.smi-tmp" > "${file}"
    rm -f "${file}.smi-tmp"
}

remove_modules_without_folder() {
    edit_file "$1/pom.xml" awk -v base="$1" '
        match($0, /<module>[^<]*<\/module>/) {
            m = substr($0, RSTART + 8, RLENGTH - 17)
            if (system("test -d \"" base "/" m "\"") != 0) next
        }
        { print }'
}

remove_attic() {
    rm -rf attic
}

remove_java_modules() {
    rm -rf java-*
}

remove_groovy_modules() {
    rm -rf groovy-*
}

remove_dependencies_bom() {
    rm -rf dependencies-bom
}

remove_maven_plugin_start_project() {
    rm -rf maven-plugin-start-project
}

remove_tomcat_start_project() {
    rm -rf tomcat-start-project
}

remove_python_ai() {
    rm -rf python-ai
}

remove_setmy_info_jail() {
    rm -rf setmy-info-jail
}

remove_submodules() {
    rm -rf submodules
}

remove_incubation() {
    rm -rf incubation
}

remove_site_tasklist() {
    rm -rf src/site/markdown/tasklist
}

remove_spring_boot_starters() {
    for starter in "${SB}"/spring-boot-*-starter; do
        case "${starter}" in
            */spring-boot-business-logic-starter) ;;
            *) rm -rf "${starter}" ;;
        esac
    done
}

remove_root_modules_without_folder() {
    remove_modules_without_folder .
}

remove_springboot_modules_without_folder() {
    remove_modules_without_folder "${SB}"
}

add_bom_version_property() {
    grep -q '<setmy.info.version>' pom.xml && return 0
    edit_file pom.xml awk \
        -v version="$(sed -n 's|^    <version>\(.*\)</version>.*|\1|p' pom.xml | head -1)" '
        { print }
        !done && /<properties>/ {
            indent = $0
            sub(/<properties>.*/, "", indent)
            print indent "    <setmy.info.version>" version "</setmy.info.version>"
            done = 1
        }'
}

use_bom_version_property() {
    edit_file pom.xml awk '
        /<artifactId>dependencies-bom<\/artifactId>/ { bom = 1 }
        bom && /<version>/ { sub(/\$\{project\.version\}/, "${setmy.info.version}"); bom = 0 }
        { print }'
}

remove_removed_folders_from_gitmodules() {
    edit_file .gitmodules awk '
        function flush() { if (!drop) printf "%s", buf; buf = ""; drop = 0 }
        /^\[submodule / { flush() }
        /^[ \t]*path[ \t]*=/ {
            path = $0
            sub(/^[ \t]*path[ \t]*=[ \t]*/, "", path)
            if (system("test -e \"" path "\"") != 0) drop = 1
        }
        { buf = buf $0 "\n" }
        END { flush() }'
}

remove_empty_gitmodules() {
    [ -s .gitmodules ] || rm -f .gitmodules
}

remove_removed_modules_from_jenkinsfile() {
    edit_file Jenkinsfile sed \
        -e "/echo .cd java-/d" \
        -e "/echo .cd groovy-/d" \
        -e "/echo .cd dependencies-bom/d" \
        -e "/echo .cd maven-plugin-start-project/d" \
        -e "/echo .cd tomcat-start-project/d" \
        -e "/spring-boot-business-logic-starter/!{/echo .cd ${SB}\/spring-boot-/d;}"
}

rename_app_folder() {
    [ -d "${SB}/${TEMPLATE_APP}" ] || return 0
    mv "${SB}/${TEMPLATE_APP}" "${SB}/${NAME}"
}

rename_app_module() {
    edit_file "${SB}/pom.xml" sed -e "s|<module>${TEMPLATE_APP}</module>|<module>${NAME}</module>|"
}

rename_app_artifact() {
    edit_file "${SB}/${NAME}/pom.xml" sed \
        -e "s|<artifactId>${TEMPLATE_APP}</artifactId>|<artifactId>${NAME}</artifactId>|" \
        -e "s|<name>${TEMPLATE_APP}</name>|<name>${NAME}</name>|"
}

rename_root_artifact() {
    edit_file pom.xml sed -e "s|>multi-projects<|>${NAME}-parent<|"
}

rename_root_parent_of_springboot() {
    edit_file "${SB}/pom.xml" sed -e "s|<artifactId>multi-projects</artifactId>|<artifactId>${NAME}-parent</artifactId>|"
}

rename_springboot_artifact() {
    edit_file "${SB}/pom.xml" sed -e "s|>${SB}<|>${NAME}-springboot<|"
}

rename_springboot_parent_of_modules() {
    for module_pom in "${SB}"/*/pom.xml; do
        edit_file "${module_pom}" sed \
            -e "s|<artifactId>${SB}</artifactId>|<artifactId>${NAME}-springboot</artifactId>|"
    done
}

rename_app_jar_in_rpm_makefile() {
    edit_file "${SB}/${NAME}/rpm/Makefile" sed \
        -e "s|^\(JAR *:= *[$](REPO)/target/\)[$](APP)-|\1${NAME}-|"
}

rename_app_folder_in_jenkinsfile() {
    edit_file Jenkinsfile sed -e "s|${SB}/${TEMPLATE_APP}|${SB}/${NAME}|g"
}

cleanup() {
    STAGE=cleanup
    step remove_attic
    step remove_java_modules
    step remove_groovy_modules
    step remove_dependencies_bom
    step remove_maven_plugin_start_project
    step remove_tomcat_start_project
    step remove_python_ai
    step remove_setmy_info_jail
    step remove_submodules
    step remove_incubation
    step remove_site_tasklist
    step remove_spring_boot_starters
    step remove_root_modules_without_folder
    step remove_springboot_modules_without_folder
    step add_bom_version_property
    step use_bom_version_property
    step remove_removed_folders_from_gitmodules
    step remove_empty_gitmodules
    step remove_removed_modules_from_jenkinsfile
}

rename() {
    STAGE=rename
    step rename_app_folder
    step rename_app_module
    step rename_app_artifact
    step rename_root_artifact
    step rename_root_parent_of_springboot
    step rename_springboot_artifact
    step rename_springboot_parent_of_modules
    step rename_app_jar_in_rpm_makefile
    step rename_app_folder_in_jenkinsfile
}

main() {
    cleanup
    rename
}

main "$@"
