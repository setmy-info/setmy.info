        <bpmn:text>csvFileName</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0kw2q6v" associationDirection="None" sourceRef="csvToH2Db" targetRef="TextAnnotation_1wawx66" />
      <bpmn:textAnnotation id="TextAnnotation_1atgyz8">
        <bpmn:text>portionsId:portionsIds; dbName;</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0bxsev6" associationDirection="None" sourceRef="dbToUUIDPortions" targetRef="TextAnnotation_1atgyz8" />
      <bpmn:textAnnotation id="TextAnnotation_1gqfjm5">
        <bpmn:text>dbName; portionSize</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0ul5nyg" associationDirection="None" sourceRef="generatePortionsList" targetRef="TextAnnotation_1gqfjm5" />
      <bpmn:textAnnotation id="TextAnnotation_0x1my2f">
