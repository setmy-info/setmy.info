  <bpmn:process id="ParallelCarwling" name="ParallelCarwling" isExecutable="true">
    <bpmn:documentation>Parallely crawl pages</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0.0" />
    </bpmn:extensionElements>
    <bpmn:endEvent id="endEvent" name="End Event">
      <bpmn:incoming>Flow_1rfdrpw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_177t09s" sourceRef="startEvent" targetRef="fetchCSVFileNameList" />
    <bpmn:sequenceFlow id="Flow_1rfdrpw" sourceRef="FilesProcessing" targetRef="endEvent" />
    <bpmn:serviceTask id="fetchCSVFileNameList" name="Fetch CSV file name list">
      <bpmn:documentation>Getc CSV file list in input folder name</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input target="directoryName" />
        </zeebe:ioMapping>
        <zeebe:taskDefinition type="fetchCSVFileNameList" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_177t09s</bpmn:incoming>
      <bpmn:outgoing>Flow_07bhyxv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="startEvent" name="Start Event">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_177t09s</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="FilesProcessing" name="Files protsessing">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_07bhyxv</bpmn:incoming>
      <bpmn:outgoing>Flow_1rfdrpw</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=csvFileNames" inputElement="csvFileName" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Event_0oz1tfo">
        <bpmn:outgoing>Flow_1sw1al1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_0jfx3od">
        <bpmn:incoming>Flow_11ovzoo</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1sw1al1" sourceRef="Event_0oz1tfo" targetRef="csvToH2Db" />
      <bpmn:serviceTask id="csvToH2Db" name="CSV File pump ower to H2 DB file">
        <bpmn:documentation>Splits CSV content rows into portions for rows for later handling. Portion size is in header. Header is skipped. Row is cleaned and filtered from epty rows. Trimmed.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input target="csvFileName" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="splitSize" value="10" />
          </zeebe:taskHeaders>
          <zeebe:taskDefinition type="csvFileSplitting" retries="" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1sw1al1</bpmn:incoming>
        <bpmn:outgoing>Flow_0jctgkf</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0jctgkf" sourceRef="csvToH2Db" targetRef="generatePortionsList" />
      <bpmn:sequenceFlow id="Flow_11ovzoo" sourceRef="dbToUUIDPortions" targetRef="Event_0jfx3od" />
      <bpmn:subProcess id="dbToUUIDPortions" name="dbToPortions UUID for portions.">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=10" target="portionSize" />
            <zeebe:input target="dbName" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0mtreq8</bpmn:incoming>
        <bpmn:outgoing>Flow_11ovzoo</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=portionsIds" inputElement="portionsId" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
        <bpmn:startEvent id="Event_1uy7dx1">
          <bpmn:outgoing>Flow_1leswcd</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:endEvent id="Event_1efb96r">
          <bpmn:incoming>Flow_00xu57v</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1leswcd" sourceRef="Event_1uy7dx1" targetRef="portionToJSON" />
        <bpmn:serviceTask id="Activity_1vvqizd" name="JSON portion parallel processing">
          <bpmn:documentation>Get CSV files and read lines in and crawl page.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="parallelProcessing" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1s6vnqk</bpmn:incoming>
          <bpmn:outgoing>Flow_00xu57v</bpmn:outgoing>
          <bpmn:multiInstanceLoopCharacteristics>
            <bpmn:extensionElements>
              <zeebe:loopCharacteristics inputCollection="=jsonRows" inputElement="jsonRow" outputCollection="" />
            </bpmn:extensionElements>
          </bpmn:multiInstanceLoopCharacteristics>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_00xu57v" sourceRef="Activity_1vvqizd" targetRef="Event_1efb96r" />
        <bpmn:sequenceFlow id="Flow_1s6vnqk" sourceRef="portionToJSON" targetRef="Activity_1vvqizd" />
        <bpmn:serviceTask id="portionToJSON" name="Portion to JSON rows">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="portionToJSON" />
            <zeebe:ioMapping>
              <zeebe:input target="portionId" />
              <zeebe:input target="dbName" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1leswcd</bpmn:incoming>
          <bpmn:outgoing>Flow_1s6vnqk</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:textAnnotation id="TextAnnotation_08d9y11">
          <bpmn:text>csvRows</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:association id="Association_0agk3dy" associationDirection="None" sourceRef="Activity_1vvqizd" targetRef="TextAnnotation_08d9y11" />
        <bpmn:textAnnotation id="TextAnnotation_05ildke">
          <bpmn:text>portionId; dbName</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:association id="Association_1oxk1cy" associationDirection="None" sourceRef="portionToJSON" targetRef="TextAnnotation_05ildke" />
        <bpmn:textAnnotation id="TextAnnotation_1ls8rlx">
          <bpmn:text>jsonRows</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:association id="Association_18nv5er" associationDirection="None" sourceRef="portionToJSON" targetRef="TextAnnotation_1ls8rlx" />
        <bpmn:textAnnotation id="TextAnnotation_0aupjkk">
          <bpmn:text>jsonRow:jsonRows</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:association id="Association_0sybc43" associationDirection="None" sourceRef="Activity_1vvqizd" targetRef="TextAnnotation_0aupjkk" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_0mtreq8" sourceRef="generatePortionsList" targetRef="dbToUUIDPortions" />
      <bpmn:serviceTask id="generatePortionsList" name="Generate portions list from DB">
        <bpmn:documentation>One CSV file have one DB file, all rows need to be splited to portions</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input target="dbName" />
            <zeebe:input source="=5" target="portionSize" />
          </zeebe:ioMapping>
          <zeebe:taskDefinition type="generatePortionsList" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0jctgkf</bpmn:incoming>
        <bpmn:outgoing>Flow_0mtreq8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:textAnnotation id="TextAnnotation_1ws9luv">
        <bpmn:text>dbName</bpmn:text>
