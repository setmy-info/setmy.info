<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">

    <persistence-unit name="csvPersistenceUnit">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>info.setmy.crawler.entities.RecordEntity</class>

        <properties>
            <!-- The Hikari DataSource and the other settings come from HibernateService (they override these) -->
            <!-- Liquibase creates the schema, Hibernate only checks it -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
