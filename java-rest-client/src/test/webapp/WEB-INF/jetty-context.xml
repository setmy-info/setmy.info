<?xml version="1.0"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_12_0.dtd">

<Configure id="webapp" class="org.eclipse.jetty.ee11.webapp.WebAppContext">
    <Call name="setAttribute">
        <Arg>org.eclipse.jetty.webapp.WebInfIncludeJarPattern</Arg>
        <Arg>.*/.*jsp-api-[^/]\.jar$|.*/.*jsp-[^/]\.jar$|.*/.*taglibs[^/]*\.jar$</Arg>
    </Call>
</Configure>